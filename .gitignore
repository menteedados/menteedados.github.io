cat > .gitignore << 'EOF'
# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# VS Code
.vscode/
*.code-workspace

# IDE files
.idea/
*.swp
*.swo

# Temp files
*.tmp
*.temp
*.log

# Node modules (se usar no futuro)
node_modules/

# Env files
.env
.env.local

# Backup files
*.bak
*.backup

# Mac specific
.AppleDouble
.LSOverride
EOF
